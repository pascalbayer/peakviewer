{
  "name": "peakviewer",
  "version": "0.1.0",
  "description": "Mobile PWA peak finder: on-device DEM, GPU horizon rendering, sensor-based AR labelling.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pascalbayer/peakviewer.git"
  },
  "homepage": "https://pascalbayer.github.io/peakviewer/",
  "bugs": {
    "url": "https://github.com/pascalbayer/peakviewer/issues"
  },
  "scripts": {
    "gen:region": "node tools/gen_region.mjs data/gornergrat.json src/data/generated-gornergrat.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run check && npm run gen:region && node tools/build_app.mjs",
    "build:app": "node tools/build_app.mjs",
    "build:previews": "npm run gen:region && node tools/build_preview.mjs app",
    "preview": "node tools/build_preview.mjs app",
    "serve": "node -e \"require(\\\"http\\\").createServer((q,s)=>{const f=require(\\\"path\\\").join(\\\"dist/app\\\",q.url===\\\"/\\\"?\\\"index.html\\\":q.url);require(\\\"fs\\\").readFile(f,(e,d)=>{if(e){s.writeHead(404);return s.end()}s.writeHead(200,{\\\"content-type\\\":{html:\\\"text/html\\\",js:\\\"text/javascript\\\",css:\\\"text/css\\\",png:\\\"image/png\\\",webmanifest:\\\"application/manifest+json\\\"}[f.split(\\\".\\\").pop()]||\\\"application/octet-stream\\\"});s.end(d)})}).listen(8080,()=>console.log(\\\"http://localhost:8080\\\"))\"",
    "check:shaders": "node tools/check_wgsl.mjs && node tools/check_math.mjs",
    "check": "tsc --noEmit && npm run check:shaders",
    "build:pages": "npm run check && npm run gen:region && node tools/build_app.mjs docs && node tools/build_preview.mjs app && node tools/copy_demo.mjs && node tools/gen_notices.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.19.0",
    "geomagnetism": "^0.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "wgsl_reflect": "^1.5.0"
  }
}
