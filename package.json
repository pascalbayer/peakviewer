{
  "name": "peakviewer",
  "version": "0.1.0",
  "description": "Mobile PWA peak finder: on-device DEM, GPU horizon rendering, sensor-based AR labelling.",
  "scripts": {
    "gen:region": "node tools/gen_region.mjs data/gornergrat.json src/data/generated-gornergrat.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run gen:region && node tools/build_app.mjs",
    "build:app": "node tools/build_app.mjs",
    "build:previews": "npm run gen:region && for s in step1 step2 step3 step4 step5 step6; do node tools/build_preview.mjs $s; done",
    "preview": "node tools/build_preview.mjs",
    "serve": "node -e \"require(\\\"http\\\").createServer((q,s)=>{const f=require(\\\"path\\\").join(\\\"dist/app\\\",q.url===\\\"/\\\"?\\\"index.html\\\":q.url);require(\\\"fs\\\").readFile(f,(e,d)=>{if(e){s.writeHead(404);return s.end()}s.writeHead(200,{\\\"content-type\\\":{html:\\\"text/html\\\",js:\\\"text/javascript\\\",css:\\\"text/css\\\",png:\\\"image/png\\\",webmanifest:\\\"application/manifest+json\\\"}[f.split(\\\".\\\").pop()]||\\\"application/octet-stream\\\"});s.end(d)})}).listen(8080,()=>console.log(\\\"http://localhost:8080\\\"))\""
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:41729/git/pascalbayer/peakviewer"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "geomagnetism": "^0.2.0"
  }
}
